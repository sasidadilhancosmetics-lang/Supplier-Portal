enum OsfRequestSuggestionMappingStatus {
  MATCHED_SUPPLIER
  UNRESOLVED_SUPPLIER
  /// Portal supplier resolved but not ACTIVE or not brand-eligible for the line.
  INELIGIBLE_BRAND
  /// Line is zero/excluded/unmapped; suggestion preserved but not sendable yet.
  LINE_NOT_ACTIONABLE
}

// --- Amendments to existing models ------------------------------------------

// model OsfImportLine { ... existing fields ...
//   requestSuggestions OsfRequestSuggestion[]
//   @@unique([id, companyId])                              // APPROVED
//   @@unique([id, osfImportId, companyId])                 // APPROVED
//   @@unique([id, osfImportId, companyId, lineKey])        // HARDENING (lineKey bind)
// }

// model Supplier {
//   /// Cosmo OS Supplier.id (cuid). Never auto-filled from name.
//   externalId String?
//   osfRequestSuggestions OsfRequestSuggestion[]
//   @@unique([companyId, externalId])                      // APPROVED (NULLs distinct)
//   // existing @@index([externalId]) may remain or be dropped as redundant
// }

// model OsfImport { requestSuggestions OsfRequestSuggestion[] }
// model Company   { osfRequestSuggestions OsfRequestSuggestion[] }

model OsfRequestSuggestion {
  id                  String                           @id @default(cuid())
  companyId           String
  osfImportId         String
  osfImportLineId     String
  /// Must match OsfImportLine.lineKey for osfImportLineId (enforced by quad FK).
  lineKey             String
  cosmoSupplierId     String
  cosmoSupplierCode   String?
  cosmoSupplierName   String
  suggestedRequestQty Decimal                          @db.Decimal(18, 4)
  /// Set for MATCHED_SUPPLIER and INELIGIBLE_BRAND; null for UNRESOLVED_SUPPLIER.
  supplierId          String?
  mappingStatus       OsfRequestSuggestionMappingStatus
  sourceSnapshot      Json
  /// Soft flags e.g. { "overLineQty": true } — ingest accepts over-line sums.
  warningFlags        Json?
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  osfImport OsfImport @relation(fields: [osfImportId, companyId], references: [id, companyId], onDelete: Restrict)
  osfImportLine OsfImportLine @relation(
    fields: [osfImportLineId, osfImportId, companyId, lineKey],
    references: [id, osfImportId, companyId, lineKey],
    onDelete: Restrict
  )
  supplier Supplier? @relation(
    fields: [supplierId, companyId],
    references: [id, companyId],
    onDelete: Restrict
  )

  @@unique([osfImportId, osfImportLineId, cosmoSupplierId])
  @@index([companyId, osfImportId])
  @@index([osfImportId, mappingStatus])
  @@index([supplierId])
  @@index([lineKey])
}
