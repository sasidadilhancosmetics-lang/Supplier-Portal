# Copy to .env.local for local development. Never commit real secrets.
# `neon init` populates database vars from your Neon project (pooled + unpooled URLs).

# Pooled connection string — used by the app Prisma Client (@prisma/adapter-neon).
DATABASE_URL=

# Direct (unpooled) connection string — used by Prisma Migrate via prisma.config.ts.
DATABASE_URL_UNPOOLED=

# Optional alias for the unpooled URL (same value as DATABASE_URL_UNPOOLED).
DIRECT_DATABASE_URL=

# Neon branch metadata (written by neon init / neon checkout).
NEON_BRANCH=
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=

# Auth0 (@auth0/nextjs-auth0 v4) — Regular Web Application for Supplier Portal development.
# See docs/auth0-setup.md for dashboard URLs and provisioning rules.
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32-byte hex secret for encrypting session cookies: openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
