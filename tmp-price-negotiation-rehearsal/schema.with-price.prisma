// Stage 2B: approved schema. Migrations via prisma.config.ts (Prisma ORM 7).
// Runtime client: src/lib/db.ts with @prisma/adapter-neon (pooled DATABASE_URL).
// Migrate uses DATABASE_URL_UNPOOLED / DIRECT_DATABASE_URL (never pooler).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  STAFF
  SUPPLIER
}

/// Supplier user invitation lifecycle. Expiry is also enforced via expiresAt.
enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum SupplierStatus {
  PENDING_REVIEW
  ACTIVE
  INACTIVE
  /// Self-registration rejected by admin (distinct from ordinary deactivation).
  REJECTED
}

/// How the supplier company record was created.
enum SupplierRegistrationSource {
  ADMIN
  SELF
}

/// Provisional staff permission catalog. Finalize before enforcing in APIs.
enum StaffPermissionCode {
  MANAGE_SUPPLIERS
  MANAGE_BRANDS
  MANAGE_PRODUCTS
  /// Create/edit draft requirements (Stage 5B split from confirm).
  MANAGE_REQUIREMENTS
  CONFIRM_REQUIREMENT
  SEND_SUPPLIER_REQUEST
  ALLOCATE_ORDER
  VERIFY_DELIVERY
  ISSUE_GRN
  REVIEW_PRODUCT_OFFER
  APPROVE_PERFORMANCE_EXCEPTION
  VIEW_REPORTS
}

enum ProductPriorityStatus {
  NORMAL
  HIGH
  CRITICAL
}

enum OsfImportStatus {
  RECEIVED
  /// Legacy: read as READY_TO_CONFIRM. Kept for backward compatibility; new writes do not use it.
  PROCESSED
  FAILED
  NEEDS_REVIEW
  READY_TO_CONFIRM
  CONFIRMED
}

enum OsfImportLineMappingStatus {
  MATCHED_SKU
  UNKNOWN_SKU
  AMBIGUOUS_SKU
  UNKNOWN_BRAND
  REJECTED_ZERO_QTY
  REJECTED_INVALID_QTY
  EXCLUDED
}

enum OsfImportDistributionStatus {
  IN_PROGRESS
  SUCCEEDED
  /// Every eligible supplier already had an active request; no new requests were created.
  SKIPPED_ALREADY_REQUESTED
  FAILED
}

/// Cosmo OS allocation suggestion → Portal supplier mapping state (Phase F2).
enum OsfRequestSuggestionMappingStatus {
  MATCHED_SUPPLIER
  UNRESOLVED_SUPPLIER
  /// Portal supplier resolved but not ACTIVE or not brand-eligible for the line.
  INELIGIBLE_BRAND
  /// Line is zero/excluded/unmapped; suggestion preserved but not sendable yet.
  LINE_NOT_ACTIONABLE
}

enum RequirementStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum SupplierRequestStatus {
  NEW
  PARTIALLY_RESPONDED
  RESPONDED
  CANCELLED
  CLOSED
}

enum AvailabilityOfferStatus {
  DRAFT
  SUBMITTED
  NOT_AVAILABLE
  /// Supplier cancelled remaining reserve and/or withdrew the offer.
  CANCELLED
  EXPIRED
}

enum AvailabilityChangeType {
  DRAFT_SAVED
  SUBMITTED
  QUANTITY_DECREASED
  QUANTITY_INCREASED
  DATE_CHANGED
  PRICE_CHANGED
  MARKED_NOT_AVAILABLE
  RESERVE_CANCELLED
  ORDER_ALLOCATION_INCREASED
  /// Partial or full release of ordered qty back from an order line (not double-counted).
  ORDER_ALLOCATION_RELEASED
  EXPIRED
  WARNING_BELOW_ORDERED
}

enum PerformanceAdjustmentUnit {
  /// Penalty score points reduced when exception is APPROVED.
  PENALTY_POINTS
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  PARTIALLY_DELIVERED
  /// Some lines partially/fully cancelled while other qty remains received or open.
  PARTIALLY_CANCELLED
  DELIVERED
  CANCELLED
}

enum OrderItemStatus {
  /// No cancellation; open and/or partially delivered.
  ACTIVE
  /// Some qty cancelled; verified/received qty (if any) is preserved.
  PARTIALLY_CANCELLED
  /// Entire ordered qty cancelled; quantityVerifiedReceived must be 0.
  CANCELLED
  /// Fully verified/received; quantityCancelled must be 0.
  FULFILLED
}

/// Portal product master state. Offer→order must not invent an ERP master.
enum ProductMasterStatus {
  /// Internal portal product; erpItemId must be null.
  PROVISIONAL
  /// Linked to an existing ERP item id (import or later sync). Not created by offer conversion alone.
  ERP_LINKED
}

enum DeliveryStatus {
  /// Counts against remaining deliverable capacity (holds qty until verified/rejected).
  SUBMITTED
  /// Accepted quantity; counts toward verified received totals.
  VERIFIED
  /// Does not count toward ordered or verified totals.
  REJECTED
}

enum GrnStatus {
  ISSUED
}

enum ProductOfferStatus {
  DRAFT
  SUBMITTED
  STAFF_INTERESTED
  STAFF_NOT_INTERESTED
  SUPPLIER_RECONFIRMED
  CONVERTED_TO_ORDER
  EXPIRED
  CANCELLED
}

enum NotificationStatus {
  UNREAD
  READ
}

enum PerformanceExceptionType {
  /// Company-caused delay; preserves scoring against original expected date rules.
  COMPANY_CAUSED_DELAY
  /// Approved reduction of cancellation penalty points.
  CANCELLATION_PENALTY_REDUCTION
}

enum PerformanceExceptionStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Organization and identity
// ---------------------------------------------------------------------------

/// Single purchasing company for Phase 1 (expect one row).
model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  suppliers          Supplier[]
  brands             Brand[]
  products           Product[]
  osfImports         OsfImport[]
  requirements       Requirement[]
  supplierRequests   SupplierRequest[]
  purchaseOrders     PurchaseOrder[]
  productOffers      ProductOffer[]
  performanceExceptions PerformanceException[]
  supplierInvitations SupplierInvitation[]
  osfImportLines         OsfImportLine[]
  osfImportDistributions OsfImportDistribution[]
  integrationCredentials IntegrationCredential[]
  osfRequestSuggestions  OsfRequestSuggestion[]
}

model User {
  id           String    @id @default(cuid())
  companyId    String
  /// Required when role = SUPPLIER; must be null for ADMIN/STAFF (app-enforced).
  supplierId   String?
  role         UserRole
  email        String    @unique
  name         String?
  /// Legacy optional field. Auth0 is the login provider; do not use for Auth0.
  passwordHash String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  /// Optional; when set, companyId must match the supplier's company (composite FK).
  supplier Supplier? @relation(fields: [supplierId, companyId], references: [id, companyId], onDelete: Restrict)

  /// Auth0 (and future IdP) subjects mapped to this internal user. Never use Auth0 sub as User.id.
  externalIdentities ExternalIdentity[]

  staffPermissions StaffPermission[]
  notifications    Notification[]
  auditLogs        AuditLog[]

  invitationsSent     SupplierInvitation[] @relation("InvitationInvitedBy")
  invitationsAccepted SupplierInvitation[] @relation("InvitationAcceptedBy")
  invitationsRevoked  SupplierInvitation[] @relation("InvitationRevokedBy")
  suppliersReviewed   Supplier[]            @relation("SupplierReviewedBy")

  availabilityChanges       AvailabilityChange[]     @relation("AvailabilityChangeActor")
  confirmedRequirements     Requirement[]            @relation("RequirementConfirmedBy")
  verifiedDeliveries        Delivery[]               @relation("DeliveryVerifiedBy")
  issuedGrns                Grn[]                    @relation("GrnIssuedBy")
  reviewedProductOffers     ProductOffer[]           @relation("ProductOfferReviewedBy")
  performanceExceptionsRequested PerformanceException[] @relation("PerformanceExceptionRequestedBy")
  performanceExceptionsReviewed  PerformanceException[] @relation("PerformanceExceptionReviewedBy")

  osfImportsConfirmed           OsfImport[]             @relation("OsfImportConfirmedBy")
  osfImportDistributionsClaimed OsfImportDistribution[] @relation("OsfImportDistributionClaimedBy")
  integrationCredentialsCreated IntegrationCredential[] @relation("IntegrationCredentialCreatedBy")
  integrationCredentialsRevoked IntegrationCredential[] @relation("IntegrationCredentialRevokedBy")

  @@index([companyId, role])
  @@index([supplierId])
}

/// Maps an external IdP subject to an internal User.id.
/// Supports moving from a personal Auth0 tenant to a company-owned tenant by storing issuer.
/// Never auto-link by email alone.
model ExternalIdentity {
  id              String    @id @default(cuid())
  userId          String
  /// e.g. "auth0"
  provider        String
  /// Issuer URL / tenant identifier (survives Auth0 domain differences).
  providerIssuer  String
  /// Stable subject from the IdP (Auth0 `sub`). Not a business key.
  providerSubject String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerIssuer, providerSubject])
  @@index([userId])
}

model StaffPermission {
  id        String              @id @default(cuid())
  userId    String
  code      StaffPermissionCode
  createdAt DateTime            @default(now())

  /// Safe: permission grants only; not business history.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([code])
}

model Supplier {
  id           String         @id @default(cuid())
  companyId    String
  name         String
  status       SupplierStatus @default(PENDING_REVIEW)
  /// ADMIN-created vs supplier self-registration.
  registrationSource SupplierRegistrationSource @default(ADMIN)
  /// Required when status = REJECTED (self-registration rejection reason).
  rejectionReason String?
  reviewedAt   DateTime?
  reviewedByUserId String?
  /// When true, supplier matches every Brand for request distribution.
  /// Specific SupplierBrand rows may still exist; All Brands wins for matching.
  supportsAllBrands Boolean   @default(false)
  contactName  String?
  contactEmail String?
  contactPhone String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  country      String?
  notes        String?
  /// Cosmo OS Supplier.id (cuid). Never auto-matched by name.
  externalId   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  reviewedBy User? @relation("SupplierReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  users              User[]
  brands             SupplierBrand[]
  invitations        SupplierInvitation[]
  supplierRequests   SupplierRequest[]
  availabilityOffers AvailabilityOffer[]
  purchaseOrders     PurchaseOrder[]
  productOffers      ProductOffer[]
  osfRequestSuggestions OsfRequestSuggestion[]

  /// Supports composite FKs that bind child rows to (supplier, company).
  @@unique([id, companyId])
  /// Company-scoped Cosmo supplier id. Multiple NULLs allowed in PostgreSQL.
  @@unique([companyId, externalId])
  @@index([companyId, status])
  @@index([companyId, registrationSource, status])
  @@index([companyId, supportsAllBrands])
  @@index([externalId])
}

/// Admin-issued invite for a supplier-company user. Email is destination only — never identity proof.
/// Store tokenHash only; plaintext token is shown once (or emailed) and never logged.
model SupplierInvitation {
  id              String           @id @default(cuid())
  companyId       String
  supplierId      String
  /// Normalized lowercase email the invite was sent to.
  invitedEmail    String
  /// Always SUPPLIER for Stage 4B; never accept ADMIN/STAFF from client input.
  role            UserRole         @default(SUPPLIER)
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  invitedByUserId String
  acceptedAt      DateTime?
  acceptedUserId  String?
  revokedAt       DateTime?
  revokedByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  supplier    Supplier @relation(fields: [supplierId, companyId], references: [id, companyId], onDelete: Restrict)
  invitedBy   User     @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedUser User?   @relation("InvitationAcceptedBy", fields: [acceptedUserId], references: [id], onDelete: Restrict)
  revokedBy   User?    @relation("InvitationRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@index([supplierId, status])
  @@index([companyId, invitedEmail, status])
  @@index([expiresAt, status])
}

model Brand {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  products         Product[]
  suppliers        SupplierBrand[]
  requirements     Requirement[]
  supplierRequests SupplierRequest[]
  osfImportLines   OsfImportLine[]

  @@unique([companyId, name])
}

/// Explicit brand membership. Deletion blocked in app while supplier has an
/// active SupplierRequest for this brand (or any active request if supportsAllBrands
/// is being turned off — app rule). Prefer Restrict over silent cascade.
model SupplierBrand {
  id         String   @id @default(cuid())
  supplierId String
  brandId    String
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  brand    Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([supplierId, brandId])
  @@index([brandId])
}

// ---------------------------------------------------------------------------
// Product reference data (brand-specific for OSF / request matching)
// ---------------------------------------------------------------------------

model Product {
  id             String                @id @default(cuid())
  companyId      String
  /// Brand for brand-specific requirements and supplier matching.
  brandId        String
  name           String
  sku            String?
  /// Set only when masterStatus = ERP_LINKED. Null for PROVISIONAL.
  /// Offer→order creates PROVISIONAL products; it does not create an ERP master.
  erpItemId      String?
  cosmoItemId    String?
  unitOfMeasure  String?
  priorityStatus ProductPriorityStatus @default(NORMAL)
  masterStatus   ProductMasterStatus   @default(PROVISIONAL)
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  brand   Brand   @relation(fields: [brandId], references: [id], onDelete: Restrict)

  requirementItems  RequirementItem[]
  requestItems      RequestItem[]
  orderItems        OrderItem[]
  productOfferItems ProductOfferItem[]
  osfImportLines    OsfImportLine[]

  @@unique([companyId, erpItemId])
  @@index([companyId, brandId])
  @@index([companyId, cosmoItemId])
  @@index([companyId, priorityStatus])
  @@index([companyId, masterStatus])
}

// ---------------------------------------------------------------------------
// OSF import and requirements
// ---------------------------------------------------------------------------

model OsfImport {
  id             String          @id @default(cuid())
  companyId      String
  externalId     String?
  idempotencyKey String
  /// SHA-256 hex of the canonical ingest payload. Same key + different hash = conflict.
  payloadHash    String
  /// Integration contract version, e.g. "cosmo-osf-push.v1".
  contractVersion String?
  /// Credential that pushed this import (null for imports created before Phase B).
  integrationCredentialId String?
  status         OsfImportStatus @default(RECEIVED)
  payload        Json
  errorMessage   String?
  /// Optimistic concurrency for review edits and batch confirmation.
  version        Int             @default(1)
  receivedAt     DateTime        @default(now())
  processedAt    DateTime?
  confirmedAt    DateTime?
  confirmedById  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  company               Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  integrationCredential IntegrationCredential?  @relation(fields: [integrationCredentialId], references: [id], onDelete: Restrict)
  confirmedBy           User?                   @relation("OsfImportConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)
  requirements          Requirement[]
  lines                 OsfImportLine[]
  distributions         OsfImportDistribution[]
  requestSuggestions    OsfRequestSuggestion[]

  @@unique([companyId, idempotencyKey])
  /// Composite target so child rows cannot reference another company's import.
  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([externalId])
  @@index([integrationCredentialId])
}

/// One row per inbound import line, matched or not. Never silently dropped.
model OsfImportLine {
  id                  String                     @id @default(cuid())
  companyId           String
  osfImportId         String
  /// Zero-based position in the inbound payload items array.
  sourceIndex         Int
  /// Stable within the import (Cosmo lineKey, typically the SKU).
  lineKey             String
  sku                 String
  descriptionSnapshot String
  cosmoVendorId       String?
  brandNameSnapshot   String
  erp1Priority        String?
  erp2Priority        String?
  /// Quantity proposed by Cosmo (TOTAL ORDER QTY at send time). Never edited.
  quantityProposed    Decimal                    @db.Decimal(18, 4)
  /// Current staff-reviewed quantity; mirrors RequirementItem.quantityPlanned when linked.
  quantityPlanned     Decimal                    @db.Decimal(18, 4)
  mappingStatus       OsfImportLineMappingStatus
  brandId             String?
  productId           String?
  requirementId       String?
  requirementItemId   String?                    @unique
  resolutionNote      String?
  version             Int                        @default(1)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  osfImport       OsfImport        @relation(fields: [osfImportId, companyId], references: [id, companyId], onDelete: Restrict)
  brand           Brand?           @relation(fields: [brandId], references: [id], onDelete: Restrict)
  product         Product?         @relation(fields: [productId], references: [id], onDelete: Restrict)
  requirement     Requirement?     @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  requirementItem RequirementItem? @relation(fields: [requirementItemId], references: [id], onDelete: Restrict)
  requestSuggestions OsfRequestSuggestion[]

  @@unique([osfImportId, lineKey])
  @@unique([osfImportId, sourceIndex])
  @@unique([id, companyId])
  @@unique([id, osfImportId, companyId])
  @@unique([id, osfImportId, companyId, lineKey])
  @@index([companyId, osfImportId])
  @@index([osfImportId, mappingStatus])
  @@index([osfImportId, brandId])
  @@index([requirementId])
  @@index([productId])
}

/// Cosmo allocation suggestion for an import line (availability-request advice only).
model OsfRequestSuggestion {
  id                  String                           @id @default(cuid())
  companyId           String
  osfImportId         String
  osfImportLineId     String
  /// Must match OsfImportLine.lineKey for osfImportLineId (quad FK).
  lineKey             String
  cosmoSupplierId     String
  cosmoSupplierCode   String?
  cosmoSupplierName   String
  suggestedRequestQty Decimal                          @db.Decimal(18, 4)
  /// Set for MATCHED_SUPPLIER and INELIGIBLE_BRAND; null for UNRESOLVED_SUPPLIER.
  supplierId          String?
  mappingStatus       OsfRequestSuggestionMappingStatus
  sourceSnapshot      Json
  /// Soft flags e.g. { "overLineQty": true }.
  warningFlags        Json?
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  osfImport     OsfImport     @relation(fields: [osfImportId, companyId], references: [id, companyId], onDelete: Restrict)
  osfImportLine OsfImportLine @relation(fields: [osfImportLineId, osfImportId, companyId, lineKey], references: [id, osfImportId, companyId, lineKey], onDelete: Restrict)
  supplier      Supplier?     @relation(fields: [supplierId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([osfImportId, osfImportLineId, cosmoSupplierId])
  @@index([companyId, osfImportId])
  @@index([osfImportId, mappingStatus])
  @@index([supplierId])
  @@index([lineKey])
}

/// Per-requirement distribution ledger for an import. SUCCEEDED and
/// SKIPPED_ALREADY_REQUESTED rows are never re-sent by the import retry path.
model OsfImportDistribution {
  id             String                      @id @default(cuid())
  companyId      String
  osfImportId    String
  requirementId  String
  status         OsfImportDistributionStatus
  /// Random token identifying the current claim holder while IN_PROGRESS.
  claimToken     String?
  claimedById    String?
  claimedAt      DateTime?
  /// IN_PROGRESS claims past this time may be reclaimed.
  claimExpiresAt DateTime?
  attemptCount   Int                         @default(0)
  /// SupplierRequest ids created by the successful attempt.
  supplierRequestIds Json?
  /// Supplier ids that already had an active request (SKIPPED_ALREADY_REQUESTED outcome).
  alreadyRequestedSupplierIds Json?
  lastError      String?
  /// Set when the row reaches SUCCEEDED or SKIPPED_ALREADY_REQUESTED.
  completedAt    DateTime?
  version        Int                         @default(1)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  osfImport   OsfImport   @relation(fields: [osfImportId, companyId], references: [id, companyId], onDelete: Restrict)
  requirement Requirement @relation(fields: [requirementId, companyId], references: [id, companyId], onDelete: Restrict)
  claimedBy   User?       @relation("OsfImportDistributionClaimedBy", fields: [claimedById], references: [id], onDelete: Restrict)

  @@unique([osfImportId, requirementId])
  @@index([companyId, status])
  @@index([osfImportId, status])
  @@index([requirementId])
  @@index([status, claimExpiresAt])
}

/// Server-to-server credential bound to one Portal company and one Cosmo tenant.
/// Multiple active rows per binding are allowed for zero-downtime token rotation.
model IntegrationCredential {
  id             String    @id @default(cuid())
  companyId      String
  /// Cosmo tenant id this credential may act for. Inbound cosmoCompanyId must match.
  cosmoCompanyId String
  name           String
  /// SHA-256 hex of the bearer token. Plain token is never stored.
  tokenHash      String    @unique
  /// Non-secret prefix shown to staff for identification.
  tokenPrefix    String
  isActive       Boolean   @default(true)
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  revokedById    String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy User?       @relation("IntegrationCredentialCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  revokedBy User?       @relation("IntegrationCredentialRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  osfImports OsfImport[]

  @@index([companyId, cosmoCompanyId, isActive])
}

model Requirement {
  id            String            @id @default(cuid())
  companyId     String
  osfImportId   String?
  /// Brand scope for this requirement (OSF / staff). Drives supplier matching.
  brandId       String
  status        RequirementStatus @default(DRAFT)
  title         String?
  notes         String?
  confirmedAt   DateTime?
  confirmedById String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  company     Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  osfImport   OsfImport? @relation(fields: [osfImportId], references: [id], onDelete: Restrict)
  brand       Brand      @relation(fields: [brandId], references: [id], onDelete: Restrict)
  confirmedBy User?      @relation("RequirementConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)

  items                  RequirementItem[]
  supplierRequests       SupplierRequest[]
  osfImportLines         OsfImportLine[]
  osfImportDistributions OsfImportDistribution[]

  /// One brand-scoped draft per import. NULL osfImportId (manual) rows are not constrained.
  @@unique([osfImportId, brandId])
  /// Composite target for company-safe child FKs.
  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([brandId, status])
  @@index([osfImportId])
}

model RequirementItem {
  id              String   @id @default(cuid())
  requirementId   String
  productId       String
  quantityPlanned Decimal  @db.Decimal(18, 4)
  /// Opaque import line reference when present.
  externalLineId  String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  requestItems  RequestItem[]
  osfImportLine OsfImportLine?

  @@index([requirementId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Supplier requests and availability
// ---------------------------------------------------------------------------

model SupplierRequest {
  id            String                @id @default(cuid())
  companyId     String
  requirementId String
  /// Owner supplier. Never trust a client-supplied supplierId; set server-side.
  supplierId    String
  brandId       String
  status        SupplierRequestStatus @default(NEW)
  /// Optional staff-set response deadline (UTC). Display in user timezone.
  responseDeadline DateTime?
  sentAt        DateTime?
  respondedAt   DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  supplier    Supplier    @relation(fields: [supplierId, companyId], references: [id, companyId], onDelete: Restrict)
  brand       Brand       @relation(fields: [brandId], references: [id], onDelete: Restrict)

  items RequestItem[]

  @@unique([id, supplierId])
  @@unique([id, companyId])
  @@unique([id, supplierId, companyId])
  @@index([supplierId, status])
  @@index([requirementId, supplierId])
  @@index([brandId, status])
  @@index([companyId, status])
  @@index([companyId, responseDeadline])
}

model RequestItem {
  id                String   @id @default(cuid())
  supplierRequestId String
  companyId         String
  /// Bound to parent via composite FK — cannot point at another supplier's request.
  supplierId        String
  requirementItemId String?
  productId         String
  quantityRequested Decimal  @db.Decimal(18, 4)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  supplierRequest SupplierRequest @relation(fields: [supplierRequestId, supplierId, companyId], references: [id, supplierId, companyId], onDelete: Restrict)
  requirementItem RequirementItem? @relation(fields: [requirementItemId], references: [id], onDelete: Restrict)
  product         Product          @relation(fields: [productId], references: [id], onDelete: Restrict)

  availabilityOffer AvailabilityOffer?

  @@unique([id, supplierId])
  @@index([supplierRequestId])
  @@index([supplierId])
  @@index([companyId])
  @@index([productId])
  @@index([requirementItemId])
}

/// Supplier-owned availability. Staff must never insert or inflate these rows.
///
/// Accounting (no double-count):
/// - quantityDeclared = supplier's latest declared available qty (may be < quantityOrderedActive → warning).
/// - quantityOrderedActive = sum over linked OrderItems of (quantityOrdered - quantityCancelled).
///   Verified/received qty stays inside that remainder until cancelled; cancelling only the
///   undelivered portion reduces this counter by the cancelled amount only.
/// - Remaining allocatable while reserve valid = max(0, quantityDeclared - quantityOrderedActive).
/// - Partial cancel example: ordered 100, verified 40, cancel 60 → quantityOrderedActive -= 60;
///   GRN for 40 preserved; outstanding demand += 60; no auto AvailabilityOffer.
model AvailabilityOffer {
  id                    String                  @id @default(cuid())
  requestItemId         String
  supplierId            String
  status                AvailabilityOfferStatus @default(DRAFT)
  quantityDeclared      Decimal                 @default(0) @db.Decimal(18, 4)
  /// Sum(quantityOrdered - quantityCancelled) for linked order lines. Tx-maintained.
  quantityOrderedActive Decimal                 @default(0) @db.Decimal(18, 4)
  unitPrice             Decimal?                @db.Decimal(18, 2)
  currencyCode          String?
  availableDate         DateTime?
  /// Set only on positive SUBMITTED. Null for DRAFT / NOT_AVAILABLE / unanswered.
  reservedAt            DateTime?
  /// reservedAt + 7*24h (UTC). Must not move while SUBMITTED (incl. partial orders).
  /// Fresh clock allowed only after EXPIRED/CANCELLED → new positive submit.
  reserveExpiresAt      DateTime?
  notes                 String?
  version               Int                     @default(1)
  submittedAt           DateTime?
  cancelledAt           DateTime?
  cancelReason          String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  requestItem RequestItem @relation(fields: [requestItemId, supplierId], references: [id, supplierId], onDelete: Restrict)
  supplier    Supplier    @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  changes    AvailabilityChange[]
  orderItems OrderItem[]

  @@unique([requestItemId, supplierId])
  @@unique([id, supplierId])
  @@index([supplierId, status])
  @@index([reserveExpiresAt, status])
}

/// Append-only history. Never cascade-delete with business cleanup shortcuts.
model AvailabilityChange {
  id                    String                   @id @default(cuid())
  availabilityOfferId   String
  actorUserId           String?
  changeType            AvailabilityChangeType
  quantityDeclaredBefore Decimal?                @db.Decimal(18, 4)
  quantityDeclaredAfter  Decimal?                @db.Decimal(18, 4)
  quantityOrderedActiveBefore Decimal?           @db.Decimal(18, 4)
  quantityOrderedActiveAfter  Decimal?           @db.Decimal(18, 4)
  unitPriceBefore       Decimal?                 @db.Decimal(18, 2)
  unitPriceAfter        Decimal?                 @db.Decimal(18, 2)
  availableDateBefore   DateTime?
  availableDateAfter    DateTime?
  statusBefore          AvailabilityOfferStatus?
  statusAfter           AvailabilityOfferStatus?
  reason                String?
  warningBelowOrdered   Boolean                  @default(false)
  createdAt             DateTime                 @default(now())

  availabilityOffer AvailabilityOffer @relation(fields: [availabilityOfferId], references: [id], onDelete: Restrict)
  actorUser         User?             @relation("AvailabilityChangeActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([availabilityOfferId, createdAt])
  @@index([actorUserId])
}

// ---------------------------------------------------------------------------
// Orders, deliveries, GRN
// ---------------------------------------------------------------------------

model PurchaseOrder {
  id                         String              @id @default(cuid())
  companyId                  String
  supplierId                 String
  productOfferId             String?
  status                     PurchaseOrderStatus @default(DRAFT)
  orderNumber                String?
  currencyCode               String?
  originalExpectedDeliveryAt DateTime?
  confirmedAt                DateTime?
  cancelledAt                DateTime?
  cancelReason               String?
  version                    Int                 @default(1)
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  supplier     Supplier      @relation(fields: [supplierId, companyId], references: [id, companyId], onDelete: Restrict)
  productOffer ProductOffer? @relation(fields: [productOfferId, supplierId, companyId], references: [id, supplierId, companyId], onDelete: Restrict)

  items                 OrderItem[]
  deliveries            Delivery[]
  performanceExceptions PerformanceException[]

  @@unique([id, supplierId])
  @@unique([id, companyId])
  @@unique([id, supplierId, companyId])
  @@unique([companyId, orderNumber])
  @@index([companyId, status])
  @@index([supplierId, status])
  @@index([productOfferId])
}

/// Line-level quantities for partial delivery + partial cancel without double-counting.
/// Example: quantityOrdered=100, quantityVerifiedReceived=40, quantityCancelled=60.
model OrderItem {
  id                         String          @id @default(cuid())
  purchaseOrderId            String
  companyId                  String
  supplierId                 String
  availabilityOfferId        String?
  productOfferItemId         String?
  productId                  String
  status                     OrderItemStatus @default(ACTIVE)
  /// Original ordered quantity (does not shrink when cancelling remainder).
  quantityOrdered            Decimal         @db.Decimal(18, 4)
  /// Undelivered qty released by cancellation. Never include verified/received qty.
  quantityCancelled          Decimal         @default(0) @db.Decimal(18, 4)
  /// Denormalized sum of VERIFIED DeliveryItem qty for this line. GRN snapshots preserved separately.
  quantityVerifiedReceived   Decimal         @default(0) @db.Decimal(18, 4)
  unitPrice                  Decimal?        @db.Decimal(18, 2)
  /// Preserve for scoring; do not overwrite when delays occur.
  originalExpectedDeliveryAt DateTime?
  cancelledAt                DateTime?
  cancelReason               String?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId, supplierId, companyId], references: [id, supplierId, companyId], onDelete: Restrict)
  availabilityOffer AvailabilityOffer? @relation(fields: [availabilityOfferId, supplierId], references: [id, supplierId], onDelete: Restrict)
  productOfferItem  ProductOfferItem?  @relation(fields: [productOfferItemId, supplierId], references: [id, supplierId], onDelete: Restrict)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)

  deliveryItems         DeliveryItem[]
  performanceExceptions PerformanceException[]

  @@index([purchaseOrderId, status])
  @@index([supplierId, status])
  @@index([companyId])
  @@index([availabilityOfferId, status])
  @@index([productOfferItemId])
  @@index([productId])
}

model Delivery {
  id              String         @id @default(cuid())
  purchaseOrderId String
  companyId       String
  supplierId      String
  status          DeliveryStatus @default(SUBMITTED)
  idempotencyKey  String?
  deliveredAt     DateTime?
  notes           String?
  verifiedAt      DateTime?
  verifiedById    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId, supplierId, companyId], references: [id, supplierId, companyId], onDelete: Restrict)
  verifiedBy    User?         @relation("DeliveryVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)

  items DeliveryItem[]
  grn   Grn?

  @@unique([purchaseOrderId, idempotencyKey])
  @@index([purchaseOrderId, status])
  @@index([supplierId, status])
  @@index([companyId])
}

model DeliveryItem {
  id                String   @id @default(cuid())
  deliveryId        String
  orderItemId       String
  quantityDelivered Decimal  @db.Decimal(18, 4)
  createdAt         DateTime @default(now())

  delivery  Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([deliveryId, orderItemId])
  @@index([orderItemId])
}

/// Immutable once ISSUED. No updatedAt. Application must never UPDATE or DELETE.
/// Corrections (if ever approved) are new compensating records, never in-place edits.
model Grn {
  id            String    @id @default(cuid())
  deliveryId    String    @unique
  status        GrnStatus @default(ISSUED)
  grnNumber     String?
  issuedAt      DateTime  @default(now())
  issuedById    String
  erpDocumentId String?
  /// Snapshot notes at issue time only.
  notes         String?
  createdAt     DateTime  @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  issuedBy User     @relation("GrnIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)

  items GrnItem[]

  @@index([issuedAt])
  @@index([grnNumber])
}

model GrnItem {
  id               String  @id @default(cuid())
  grnId            String
  productId        String
  quantityReceived Decimal @db.Decimal(18, 4)
  productName      String?
  erpItemId        String?

  grn Grn @relation(fields: [grnId], references: [id], onDelete: Restrict)

  @@index([grnId])
}

// ---------------------------------------------------------------------------
// Supplier product offers
// ---------------------------------------------------------------------------

model ProductOffer {
  id                    String             @id @default(cuid())
  companyId             String
  supplierId            String
  status                ProductOfferStatus @default(DRAFT)
  validFrom             DateTime?
  validUntil            DateTime?
  staffReviewedAt       DateTime?
  staffReviewedById     String?
  supplierReconfirmedAt DateTime?
  notes                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  company         Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  supplier        Supplier @relation(fields: [supplierId, companyId], references: [id, companyId], onDelete: Restrict)
  staffReviewedBy User?    @relation("ProductOfferReviewedBy", fields: [staffReviewedById], references: [id], onDelete: Restrict)

  items          ProductOfferItem[]
  purchaseOrders PurchaseOrder[]

  @@unique([id, supplierId])
  @@unique([id, companyId])
  @@unique([id, supplierId, companyId])
  @@index([supplierId, status])
  @@index([companyId, status])
  @@index([validUntil])
}

model ProductOfferItem {
  id                String   @id @default(cuid())
  productOfferId    String
  companyId         String
  supplierId        String
  /// Existing catalog product, or provisional Product created at conversion (masterStatus=PROVISIONAL).
  productId         String?
  proposedName      String?
  proposedSku       String?
  /// Suggested code only — does not create or imply an ERP master item.
  proposedErpItemId String?
  proposedBrandId   String?
  quantityOffered   Decimal? @db.Decimal(18, 4)
  unitPrice         Decimal? @db.Decimal(18, 2)
  currencyCode      String?
  availableDate     DateTime?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  productOffer ProductOffer @relation(fields: [productOfferId, supplierId, companyId], references: [id, supplierId, companyId], onDelete: Restrict)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)

  orderItems OrderItem[]

  @@unique([id, supplierId])
  @@index([productOfferId])
  @@index([supplierId])
  @@index([companyId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Performance exceptions (lightweight Phase 1)
// ---------------------------------------------------------------------------

/// Lightweight exception records for later scoring. Not a full analytics module.
model PerformanceException {
  id                         String                     @id @default(cuid())
  companyId                  String
  type                       PerformanceExceptionType
  status                     PerformanceExceptionStatus @default(PENDING)
  purchaseOrderId            String?
  orderItemId                String?
  /// Qty affected by company-caused delay (required for COMPANY_CAUSED_DELAY in app).
  affectedQuantity           Decimal?                   @db.Decimal(18, 4)
  /// Snapshot of original expected delivery; required for delay exceptions; never overwrite OrderItem value.
  originalExpectedDeliveryAt DateTime?
  /// For CANCELLATION_PENALTY_REDUCTION: magnitude of approved/requested adjustment.
  adjustmentValue            Decimal?                   @db.Decimal(18, 4)
  adjustmentUnit             PerformanceAdjustmentUnit?
  reason                     String
  requestedById              String?
  reviewedById               String?
  reviewedAt                 DateTime?
  reviewNotes                String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  orderItem     OrderItem?     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  requestedBy   User?          @relation("PerformanceExceptionRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy    User?          @relation("PerformanceExceptionReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([companyId, type, status])
  @@index([purchaseOrderId])
  @@index([orderItemId])
}

// ---------------------------------------------------------------------------
// Notifications, audit, idempotency
// ---------------------------------------------------------------------------

model Notification {
  id         String             @id @default(cuid())
  userId     String
  title      String
  body       String
  status     NotificationStatus @default(UNREAD)
  entityType String?
  entityId   String?
  createdAt  DateTime           @default(now())
  readAt     DateTime?

  /// Safe: user inbox rows only.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  entityType  String
  entityId    String
  action      String
  beforeJson  Json?
  afterJson   Json?
  createdAt   DateTime @default(now())

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
}

model IdempotencyKey {
  id           String   @id @default(cuid())
  scope        String
  key          String
  responseJson Json?
  createdAt    DateTime @default(now())
  expiresAt    DateTime?

  @@unique([scope, key])
  @@index([expiresAt])
}


// ---------------------------------------------------------------------------
// Proposed additions � Price comparison & negotiation (NOT APPLIED)
// Paste into prisma/schema.prisma only after migration approval.
// ---------------------------------------------------------------------------

enum PriceNegotiationChannel {
  PORTAL
  PHONE
  WHATSAPP
}

/// What this append-only quote row represents.
enum PriceQuoteKind {
  /// Supplier original quote on availability submit / first portal offer.
  SUPPLIER_ORIGINAL
  /// Supplier revised offer after a counter or external discussion.
  SUPPLIER_REVISED
  /// Company staff counteroffer (portal).
  COMPANY_COUNTER
  /// Staff-recorded result of Phone/WhatsApp negotiation (not auto supplier-confirmed).
  STAFF_RECORDED_EXTERNAL
  /// Supplier accepted a company counter via portal.
  SUPPLIER_ACCEPTANCE
}

/// Lifecycle of a quote / agreement pointer. Staff-recorded ? supplier-confirmed.
enum PriceAgreementStatus {
  /// Latest supplier quote only; no company agreement yet.
  QUOTED
  /// Company counter awaiting supplier response.
  COUNTER_PENDING
  /// Staff recorded an external price; supplier has not confirmed in-portal.
  STAFF_RECORDED_UNCONFIRMED
  /// Supplier confirmed/accepted the price in-portal.
  SUPPLIER_CONFIRMED
  /// Staff attested an external agreement with required attestation + evidence note.
  STAFF_ATTESTED_AGREED
  /// Explicitly declined / abandoned.
  DECLINED
  /// Replaced by a newer quote (history row only).
  SUPERSEDED
}

/// Append-only price history. Never UPDATE unitPrice; supersede instead.
model PriceQuote {
  id                   String                   @id @default(cuid())
  companyId            String
  supplierId           String
  productId            String
  /// Optional binding to the live availability offer under negotiation.
  availabilityOfferId  String?
  requestItemId        String?
  supplierRequestId    String?
  channel              PriceNegotiationChannel
  kind                 PriceQuoteKind
  /// Status claimed by this event (historical). SUPERSEDED when replaced.
  status               PriceAgreementStatus
  unitPrice            Decimal                  @db.Decimal(18, 2)
  currencyCode         String?
  /// Optional qty context for the quote (does not change offer declared qty).
  quantityContext      Decimal?                 @db.Decimal(18, 4)
  availableDate        DateTime?
  notes                String?
  /// Phone/WhatsApp negotiation date (calendar); null for pure portal events.
  negotiationOccurredAt DateTime?
  /// Required when status becomes STAFF_ATTESTED_AGREED.
  attestationStatement String?
  evidenceNote         String?
  attestedAt           DateTime?
  attestedByUserId     String?
  recordedByUserId     String?
  /// Prior quote in the same thread (if any).
  supersedesQuoteId    String?
  createdAt            DateTime                 @default(now())

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  supplier          Supplier           @relation(fields: [supplierId, companyId], references: [id, companyId], onDelete: Restrict)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  availabilityOffer AvailabilityOffer? @relation(fields: [availabilityOfferId, supplierId], references: [id, supplierId], onDelete: Restrict)
  requestItem       RequestItem?       @relation(fields: [requestItemId, supplierId], references: [id, supplierId], onDelete: Restrict)
  supplierRequest   SupplierRequest?   @relation(fields: [supplierRequestId, supplierId, companyId], references: [id, supplierId, companyId], onDelete: Restrict)
  recordedBy        User?              @relation("PriceQuoteRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  attestedBy        User?              @relation("PriceQuoteAttestedBy", fields: [attestedByUserId], references: [id], onDelete: Restrict)
  supersedesQuote   PriceQuote?        @relation("PriceQuoteSupersedes", fields: [supersedesQuoteId], references: [id], onDelete: Restrict)
  supersededBy      PriceQuote[]       @relation("PriceQuoteSupersedes")

  agreementsAsCurrent PriceAgreement[] @relation("PriceAgreementCurrentQuote")
  orderItems          OrderItem[]

  @@index([companyId, productId, createdAt])
  @@index([companyId, supplierId, productId, createdAt])
  @@index([availabilityOfferId, createdAt])
  @@index([supplierRequestId])
  @@index([requestItemId])
  @@index([supersedesQuoteId])
}

/// Mutable pointer to the current commercial agreement for an offer/SKU pair.
/// unitPrice is denormalized from currentQuote and must match it.
model PriceAgreement {
  id                  String                @id @default(cuid())
  companyId           String
  supplierId          String
  productId           String
  /// Required: one agreement pointer per AvailabilityOffer (matches migration.sql UNIQUE).
  availabilityOfferId String
  requestItemId       String?
  status              PriceAgreementStatus
  currentQuoteId      String
  unitPrice           Decimal               @db.Decimal(18, 2)
  currencyCode        String?
  channel             PriceNegotiationChannel
  version             Int                   @default(1)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  supplier          Supplier           @relation(fields: [supplierId, companyId], references: [id, companyId], onDelete: Restrict)
  product           Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  availabilityOffer AvailabilityOffer  @relation(fields: [availabilityOfferId, supplierId], references: [id, supplierId], onDelete: Restrict)
  requestItem       RequestItem?       @relation(fields: [requestItemId, supplierId], references: [id, supplierId], onDelete: Restrict)
  currentQuote      PriceQuote         @relation("PriceAgreementCurrentQuote", fields: [currentQuoteId], references: [id], onDelete: Restrict)

  @@unique([availabilityOfferId])
  @@index([companyId, productId, status])
  @@index([supplierId, status])
  @@index([currentQuoteId])
}

